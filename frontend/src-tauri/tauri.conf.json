{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MindCore",
  "version": "0.1.1",
  "identifier": "com.luskacat.mindcore",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1 --port 1420",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MindCore",
        "width": 1200,
        "height": 800,
        "minWidth": 850,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http: https: ws: wss:; img-src 'self' asset: http: https: data:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/mindcore-backend"]
  }
}

# Backend settings only. Keep real keys in the untracked .env file or Render secrets.
APP_ENV=development
# Public desktop default is the generic identity template. A private developer
# profile may set PERSONA_IDENTITY_PATH outside the application bundle.
PERSONA_DISPLAY_NAME=Persona
USER_DISPLAY_NAME=User
PERSONA_IDENTITY_PATH=
# Production also requires PRIVATE_ACCESS_PASSWORD, AUTH_SIGNING_SECRET, and
# explicit CORS_ORIGINS for the deployed frontend; never commit real values.
PRIVATE_ACCESS_PASSWORD=
AUTH_SIGNING_SECRET=
CORS_ORIGINS=http://localhost:5173
# During the Supabase -> Turso migration, keep the source separately and do
# not replace it with the Turso URL.
OLD_DATABASE_URL=
DATABASE_BACKEND=turso
DATABASE_URL=
DATABASE_AUTH_TOKEN=
SUPABASE_DB_URL=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_THINKING_LEVEL=minimal
GEMINI_TIMEOUT_SECONDS=45
GEMINI_MAX_RETRIES=1

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_RETRIES=2

LLM_PROVIDER=gemini
LLM_FALLBACK_PROVIDER=groq

# Used only when Safari blocks a cross-site HttpOnly cookie. The browser keeps
# the fallback access token in sessionStorage, never in the Vite bundle.
AUTH_BEARER_SESSION_MAX_AGE_SECONDS=28800
DIANA_TIMEZONE=Asia/Seoul
